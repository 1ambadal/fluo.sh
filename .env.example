# Database settings
DATABASE_PATH=data/app.db

# LLM settings (DeepSeek)
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# STT settings (faster-whisper)
WHISPER_MODEL_SIZE=large-v3-turbo
WHISPER_DEVICE=cuda
WHISPER_COMPUTE_TYPE=int8_float16

# TTS settings (Kokoro-82M)
KOKORO_MODEL_PATH=models/kokoro-v1.0.onnx
KOKORO_VOICES_PATH=models/voices-v1.0.bin
KOKORO_VOICE_DEFAULT=af_bella

# VAD settings (Silero VAD)
VAD_MODEL_PATH=models/silero_vad.onnx
